# Plantilla pública. Configura los valores reales en IntelliJ > Edit Configurations > Environment variables.
# Supabase > Connect > Session pooler, puerto 5432. DB_HOST contiene solo el hostname.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSL_ROOT_CERT=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
APP_ADMIN_USER_ID=
APP_PUBLIC_URL=https://localhost:8080
# Ejecuta scripts/prepare-local-tls.ps1 para generar el almacén local en data/tls.
# Para TLS directo en producción, configura APP_TLS_KEY_STORE y APP_TLS_KEY_STORE_PASSWORD.
APP_TLS_ENABLED=true
APP_FORWARD_HEADERS_STRATEGY=none
